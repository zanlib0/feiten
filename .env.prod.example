# Required — generate with: cd backend && mix phx.gen.secret
SECRET_KEY_BASE=

# Required — choose a strong password
POSTGRES_PASSWORD=

# Required — password for the backend's MQTT subscriber identity (feiten_backend)
MQTT_BACKEND_PASSWORD=

# Required — hostname/IP that sensors connect to for MQTT (baked into the curl
# shown in the dashboard). Usually your public hostname or LAN IP.
MQTT_PUBLIC_HOST=

# Optional — hostname Phoenix uses for URL generation (default: localhost)
PHX_HOST=localhost

# Optional — host port for the frontend (default: 80)
HTTP_PORT=80

# Optional — host port the broker's plaintext listener binds to (default: 1883).
# Plaintext on the LAN is fine for trusted networks. If you put a TLS terminator
# in front for public exposure, prefer binding this back to loopback in compose.
MQTT_INTERNAL_PORT=1883

# Optional — scheme advertised in the curl shown in the dashboard. Set to "mqtts"
# if a TLS terminator fronts the broker. (default: mqtt)
MQTT_PUBLIC_SCHEME=mqtt

# Optional — public port advertised in the curl (default: 1883)
MQTT_PUBLIC_PORT=1883

# Optional — DB connection pool size (default: 10)
POOL_SIZE=10
